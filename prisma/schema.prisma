// ============================================================
// EGMS - Electronic Grade Management System
// Multi-Tenant SaaS Platform
// University College of Science & Technology
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USER / AUTHENTICATION
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique @db.VarChar(255)
  name     String @db.VarChar(255)
  password String @db.VarChar(255)

  emailVerifiedAt DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  status UserStatus @default(ACTIVE)

  // Authentication / RBAC
  emailVerifications EmailVerification[]
  resetPasswords     ResetPassword[]

  // Multi-tenancy
  memberships   InstituteMembership[]
  // Platform / RBAC
  platformRoles PlatformUserRole[]
  // Institute-scoped role assignments
  roles         UserRole[]
  // Academic profiles
  student       Student?
  lecturer      Lecturer?

  @@index([email], name: "idx_user_email")
  @@index([deletedAt], name: "idx_user_deleted_at")
  @@index([status], name: "idx_user_status")
}

// ============================================================
// EMAIL VERIFICATION
// ============================================================

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([token, usedAt])
  @@index([userId])
}

// ============================================================
// PASSWORD RESET
// ============================================================

model ResetPassword {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([token, usedAt])
  @@index([userId])
}

// ============================================================
// INSTITUTE / TENANT
// ============================================================
enum InstituteType {
  SCHOOL
  COLLEGE
  UNIVERSITY
}

enum InstituteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Institute {
  id     String          @id @default(uuid()) @db.Uuid
  code   String          @unique @db.VarChar(50)
  name   String          @db.VarChar(255)
  type   InstituteType
  status InstituteStatus @default(ACTIVE)

  email   String? @db.VarChar(255)
  phone   String? @db.VarChar(50)
  address String? @db.VarChar(500)
  country String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  city    String? @db.VarChar(100)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Users belonging to this institute
  memberships   InstituteMembership[]
  // Subscription
  subscriptions Subscription[]

  // Academic structure
  departments   Department[]
  programs      Program[]
  academicYears AcademicYear[]
  courses       Course[]
  students      Student[]
  lecturers     Lecturer[]

  @@index([status], name: "idx_institute_status")
  @@index([type], name: "idx_institute_type")
  @@index([deletedAt], name: "idx_institute_deleted_at")
}

// ============================================================
// INSTITUTE MEMBERSHIP
// ============================================================
//
// Connects a User to an Institute.
//
// Example:
//
// User: John
//       ↓
// Membership
//       ↓
// ABC School
//
// The same User can belong to another Institute later.
//

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model InstituteMembership {
  id String @id @default(uuid()) @db.Uuid

  userId      String @db.Uuid
  instituteId String @db.Uuid

  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  institute Institute @relation(fields: [instituteId], references: [id])

  // Roles assigned within this institute
  roles UserRole[]

  @@unique([userId, instituteId], name: "idx_user_institute_membership")
  @@index([userId], name: "idx_membership_user")
  @@index([instituteId], name: "idx_membership_institute")
  @@index([instituteId, status], name: "idx_membership_institute_status")
}

// ============================================================
// ROLE BASED ACCESS CONTROL
// ============================================================

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(255)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  // Users assigned this role
  users       UserRole[]
  // Permissions belonging to this role
  permissions RolePermission[]
}

// ============================================================
// PLATFORM ROLE
// ============================================================
//
// Platform roles are separate from institute roles.
// SUPER_ADMIN is therefore not tied to an institute membership.
//
model PlatformRole {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users PlatformUserRole[]
}

model PlatformUserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id])
  role PlatformRole @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId], name: "idx_platform_user_role_unique")
  @@index([userId], name: "idx_platform_user_role_user")
  @@index([roleId], name: "idx_platform_user_role_role")
}

// ============================================================
// PERMISSION
// ============================================================

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(255)
  group String @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@index([group], name: "idx_permission_group")
}

// ============================================================
// USER ↔ ROLE
// ============================================================
//
// A role assignment belongs to an InstituteMembership.
//
// Example:
//
// John
//   ↓
// ABC School Membership
//   ↓
// Institute Admin
//

model UserRole {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @db.Uuid
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id])
  membership InstituteMembership @relation(fields: [membershipId], references: [id])

  role Role @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId], name: "idx_membership_role_unique")
  @@index([userId], name: "idx_user_role_user")
  @@index([roleId], name: "idx_user_role_role")
}

// ============================================================
// ROLE ↔ PERMISSION
// ============================================================

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId], name: "idx_role_permission_unique")
}

// ============================================================
// SUBSCRIPTION PLAN
// ============================================================
//
// Defines what an institute's subscription allows.
//
model SubscriptionPlan {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  description String? @db.VarChar(500)

  // Usage limits
  maxStudents  Int?
  maxUsers     Int?
  maxLecturers Int?

  // API rate limit
  apiRequestsPerMinute Int?

  // Pricing
  price    Decimal @db.Decimal(10, 2)
  currency String  @default("USD") @db.VarChar(10)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive], name: "idx_plan_active")
}

// ============================================================
// SUBSCRIPTION
// ============================================================

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  instituteId String @db.Uuid
  planId      String @db.Uuid

  status SubscriptionStatus @default(TRIAL)

  startsAt DateTime
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institute Institute        @relation(fields: [instituteId], references: [id])
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([instituteId], name: "idx_subscription_institute")
  @@index([status], name: "idx_subscription_status")
  @@index([endsAt], name: "idx_subscription_ends_at")
}

// ============================================================
// DEPARTMENT
// ============================================================

model Department {
  id   String @id @default(uuid()) @db.Uuid
  code String @db.VarChar(50)
  name String @db.VarChar(255)

  instituteId String    @db.Uuid
  institute   Institute @relation(fields: [instituteId], references: [id])

  programs  Program[]
  courses   Course[]
  lecturers Lecturer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same code/name can exist in different institutes.
  @@unique([instituteId, code], name: "idx_department_institute_code")
  @@unique([instituteId, name], name: "idx_department_institute_name")
  @@index([instituteId], name: "idx_department_institute")
}

// ============================================================
// PROGRAM
// ============================================================

model Program {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(50)
  name String @db.VarChar(255)

  instituteId String    @db.Uuid
  institute   Institute @relation(fields: [instituteId], references: [id])

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instituteId, code], name: "idx_program_institute_code")
  @@index([instituteId], name: "idx_program_institute")
  @@index([departmentId], name: "idx_program_department")
  @@index([departmentId])
}

// ============================================================
// ACADEMIC YEAR
// ============================================================

model AcademicYear {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique @db.VarChar(20)
  startYear Int
  endYear   Int

  instituteId String    @db.Uuid
  institute   Institute @relation(fields: [instituteId], references: [id])

  semesters Semester[]

  createdAt DateTime @default(now())

  @@unique([instituteId, name], name: "idx_academic_year_institute_name")
  @@index([instituteId], name: "idx_academic_year_institute")
}

// ============================================================
// SEMESTER
// ============================================================

enum SemesterType {
  FIRST
  SECOND
  SUMMER
}

model Semester {
  id   String       @id @default(uuid()) @db.Uuid
  name SemesterType

  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  registrations CourseRegistration[]
  assignments   LecturerAssignment[]

  createdAt DateTime @default(now())

  @@unique([academicYearId, name])
  @@index([academicYearId], name: "idx_semester_academic_year")
}

// ============================================================
// COURSE
// ============================================================

model Course {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique @db.VarChar(50)
  title       String @db.VarChar(255)
  creditUnits Int

  instituteId String    @db.Uuid
  institute   Institute @relation(fields: [instituteId], references: [id])

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  registrations CourseRegistration[]
  assignments   LecturerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instituteId, code], name: "idx_course_institute_code")
  @@index([instituteId], name: "idx_course_institute")
  @@index([departmentId], name: "idx_course_department")
}

// ============================================================
// STUDENT
// ============================================================

model Student {
  id String @id @default(uuid()) @db.Uuid

  // Login account
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  // Institute / tenant
  instituteId String    @db.Uuid
  institute   Institute @relation(fields: [instituteId], references: [id])

  // Academic identity
  studentNumber String @unique @db.VarChar(50)

  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)

  // Academic program
  programId String  @db.Uuid
  program   Program @relation(fields: [programId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations CourseRegistration[]

  @@unique([instituteId, studentNumber], name: "idx_student_institute_number")
  @@index([instituteId], name: "idx_student_institute")
  @@index([programId], name: "idx_student_program")
}

// ============================================================
// LECTURER
// ============================================================

model Lecturer {
  id String @id @default(uuid()) @db.Uuid

  // Login account
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  // Institute / tenant
  instituteId String    @db.Uuid
  institute   Institute @relation(fields: [instituteId], references: [id])

  // Staff identity
  staffNumber String @db.VarChar(50)

  // Department
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments LecturerAssignment[]

  @@unique([instituteId, staffNumber], name: "idx_lecturer_institute_staff_number")
  @@index([instituteId], name: "idx_lecturer_institute")
  @@index([departmentId], name: "idx_lecturer_department")
}

// ============================================================
// COURSE REGISTRATION
// ============================================================

model CourseRegistration {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id])

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id])

  semesterId String   @db.Uuid
  semester   Semester @relation(fields: [semesterId], references: [id])

  grade Grade?

  createdAt DateTime @default(now())

  @@unique([studentId, courseId, semesterId])
  @@index([studentId], name: "idx_registration_student")
  @@index([courseId], name: "idx_registration_course")
  @@index([semesterId], name: "idx_registration_semester")
}

// ============================================================
// LECTURER ASSIGNMENT
// ============================================================

model LecturerAssignment {
  id String @id @default(uuid()) @db.Uuid

  lecturerId String   @db.Uuid
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id])

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id])

  semesterId String   @db.Uuid
  semester   Semester @relation(fields: [semesterId], references: [id])

  grades Grade[]

  createdAt DateTime @default(now())

  @@unique([lecturerId, courseId, semesterId])
  @@index([lecturerId], name: "idx_assignment_lecturer")
  @@index([courseId], name: "idx_assignment_course")
  @@index([semesterId], name: "idx_assignment_semester")
}

enum GradeStatus {
  DRAFT
  SUBMITTED
  HOD_REVIEW
  HOD_RETURNED
  HOD_APPROVED
  DEAN_REVIEW
  DEAN_RETURNED
  DEAN_APPROVED
  LOCKED
}

enum GradeComponentType {
  ATTENDANCE
  QUIZ
  ASSIGNMENT
  PROJECT
  MIDTERM
  FINAL
}

// ============================================================
// GRADE
// ============================================================

model Grade {
  id String @id @default(uuid()) @db.Uuid

  // Student's registered course
  registrationId String             @unique @db.Uuid
  registration   CourseRegistration @relation(fields: [registrationId], references: [id])

  // Lecturer responsible for the course
  assignmentId String             @db.Uuid
  assignment   LecturerAssignment @relation(fields: [assignmentId], references: [id])

  // Calculated result
  totalScore  Decimal? @db.Decimal(5, 2)
  letterGrade String?  @db.VarChar(5)

  // Approval workflow
  status GradeStatus @default(DRAFT)

  submittedAt DateTime?
  approvedAt  DateTime?
  lockedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components GradeComponent[]
}

// ============================================================
// GRADE COMPONENT
// ============================================================

model GradeComponent {
  id String @id @default(uuid()) @db.Uuid

  gradeId String @db.Uuid
  grade   Grade  @relation(fields: [gradeId], references: [id])

  type GradeComponentType

  // Example: score = 8, maxScore = 10
  score    Decimal @db.Decimal(5, 2)
  maxScore Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeId, type])
}
